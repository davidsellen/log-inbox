LOG_INBOX_BIND=127.0.0.1
LOG_INBOX_HTTP_PORT=8787
LOG_INBOX_MCP_PORT=8788
LOG_INBOX_PUBLIC_INGEST_URL=http://127.0.0.1:8787
LOG_INBOX_DATA_DIR=/data
LOG_INBOX_API_KEYS=dev-local-key
LOG_INBOX_RETENTION_DAYS=14

# Generate a private dashboard value of at least 20 bytes,
# for example with: openssl rand -base64 32
LOG_INBOX_OWNER_SECRET=
LOG_INBOX_ROTATE_OWNER_SECRET=0
LOG_INBOX_ALLOWED_HOSTS=127.0.0.1:8788,localhost:8788
LOG_INBOX_ALLOWED_ORIGINS=http://127.0.0.1:8788,http://localhost:8788
LOG_INBOX_WORKSPACE_HOST_DIR=./data/vault
LOG_INBOX_WORKSPACE_DIR=/workspace
LOG_INBOX_HOST_UID=1000
LOG_INBOX_HOST_GID=1000

# Local Ollama is private to the Compose network; no host port is published.
LOG_INBOX_LLM_BASE_URL=http://ollama:11434/v1
LOG_INBOX_LLM_MODEL=granite3.3:2b
LOG_INBOX_LLM_API_KEY=
