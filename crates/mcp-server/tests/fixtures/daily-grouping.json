          "metadata": {
            "task_id": "manual-deployment-note",
            "entry_kind": "manual"
          },
          "expected_group_key": "source:manual%2Fdashboard|task:manual-deployment-note"
        },
        {
          "id": "evt_session",
          "timestamp": "2026-09-07T14:00:00Z",
          "received_at": "2026-09-07T14:00:01Z",
          "source": "agent/fedora",
