            "event_type": "start",
            "status": "running",
            "repo": "SweetOne",
            "work_item": "ADO 57950"
          },
          "expected_group_key": "repo:sweetone|work-item:57950"
        },
        {
          "id": "evt_complete",
          "timestamp": "2026-09-07T10:00:00Z",
          "received_at": "2026-09-07T10:00:01Z",
          "source": "codex/fedora",
          "message": "Completed the review and validated the build.",
          "metadata": {
            "task_id": "review-57950",
            "sequence": 3,
            "event_type": "complete",
            "status": "succeeded",
            "repo": "SweetOne",
            "work_item": "ADO 57950"
          },
          "expected_group_key": "repo:sweetone|work-item:57950"
        },
        {
          "id": "evt_late_progress",
          "timestamp": "2026-09-07T10:05:00Z",
          "received_at": "2026-09-07T10:05:01Z",
          "source": "codex/fedora",
          "message": "Recorded a transport-only follow-up.",
          "metadata": {
            "task_id": "review-57950",
            "sequence": 4,
            "event_type": "progress",
            "status": "running",
            "repo": "SweetOne",
            "work_item": "ADO 57950"
          },
          "expected_group_key": "repo:sweetone|work-item:57950"
        }
      ],
      "expected_daily_prompt_event_ids": ["evt_start", "evt_complete", "evt_late_progress"],
      "target_contract_note": "The refocused workflow supplies the complete bounded lifecycle so unique earlier decisions and validations cannot be silently discarded."
    },
    {
