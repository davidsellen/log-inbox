# Use only while bringing data forward from a pre-Daily deployment.
# Copy these values into .env, then start with both Compose files.
LOG_INBOX_PROPOSAL_HOST_DIR=/path/to/legacy/vault-inbox
LOG_INBOX_VAULT_CONTEXT_HOST_FILE=/path/to/legacy/vault-context.json
LOG_INBOX_PRODUCT_INDEX_HOST_FILE=/path/to/legacy/product-navigation.md
